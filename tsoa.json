{
  "entryFile": "src/app.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/**/controller.ts"],
  "spec": {
    "outputDirectory": "build",
    "specVersion": 3,
    "host": "api.collegebasketballdata.com",
    "name": "College Basketball Data API",
    "description": "Use the College Basketball Data API to query game, team, player, recruiting, and analytics data. Request an API key at [CollegeBasketballData.com](https://collegebasketballdata.com/key).",
    "license": "MIT",
    "contact": {
      "email": "admin@collegefootballdata.com",
      "name": "College Basketball Data"
    },
    "securityDefinitions": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "rootSecurity": [
      {
        "apiKey": []
      }
    ],
    "tags": [
      {
        "name": "games",
        "description": "Game schedules, scores, broadcasts, and box scores."
      },
      {
        "name": "plays",
        "description": "Play-by-play data and substitution events."
      },
      {
        "name": "teams",
        "description": "Team information and rosters."
      },
      {
        "name": "conferences",
        "description": "Conference information and membership history."
      },
      {
        "name": "venues",
        "description": "Venue and location information."
      },
      {
        "name": "stats",
        "description": "Team and player season statistics."
      },
      {
        "name": "rankings",
        "description": "Historical polls and rankings."
      },
      {
        "name": "ratings",
        "description": "Historical team rating systems."
      },
      {
        "name": "lines",
        "description": "Historical betting lines and providers."
      },
      {
        "name": "lineups",
        "description": "Five-player lineup statistics."
      },
      {
        "name": "draft",
        "description": "Historical NBA draft data."
      },
      {
        "name": "recruiting",
        "description": "Historical recruiting and transfer portal data."
      }
    ]
  },
  "routes": {
    "routesDir": "build",
    "authenticationModule": "src/config/auth.ts"
  }
}
